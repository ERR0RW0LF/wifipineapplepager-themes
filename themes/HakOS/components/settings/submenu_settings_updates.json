{
  "screen_name": "settings_updates_submenu",
  "status_bar": "default",
  "windowed_canvas": false,
  "cache_canvases": false,
  "button_map": {
    "a": "select",
    "b": "back",
    "up": "previous",
    "down": "next",
    "left": "noop",
    "right": "noop"
  },
  "background": {
    "layers": [
      { "image_path": "assets/blank_recon_bg.png", "x": 0, "y": 0 },
      { "text": "Settings", "x": 10, "y": 4, "text_size": "small", "text_color_palette": "gray" },
      { "text": "Updates", "x": 10, "y": 18, "text_color_palette": "white" }
    ]
  },
  "pages": [
    {
      "page_index": 0,
      "menu_items": [
        {
          "id": "CurrentVersion",
          "x": 20,
          "y": 50,
          "unselectable": true,
          "layers": [
            { "text": "Current Version:", "text_color_palette": "white" },
            { "variable_name": "$_FIRMWARE_VERSION", "string_template": { "text_size": "medium", "text_color_palette": "white", "max_chars": 24, "wrap_text": false, "max_lines": 1 }, "x": 221 }
          ]
        },
        {
          "id": "Check for Updates",
          "x": 20,
          "y": 85,
          "layers": [
            { "image_path": "assets/wizard.png" },
            { "text": "Check for Updates", "x": 40, "text_color_palette": "white" }
          ],
          "selected_layers": [
            { "image_path": "assets/wizard.png" },
            { "text": "Check for Updates", "x": 40, "text_color_palette": "blue" }
          ],
          "target": "check_for_updates"
        },
        {
          "id": "Check for Portal Updates",
          "x": 20,
          "y": 120,
          "layers": [
            { "image_path": "assets/autoplay.png", "recolor_palette": "white" },
            { "text": "Refresh Portal", "x": 40, "text_color_palette": "white" }
          ],
          "selected_layers": [
            { "image_path": "assets/autoplay.png", "recolor_palette": "white" },
            { "text": "Refresh Portal", "x": 40, "text_color_palette": "blue" }
          ],
          "target": "function_refresh_pager_portal_data"
        }
      ]
    }
  ]
}
